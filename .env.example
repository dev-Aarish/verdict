# Frontend (Vite/TanStack Start) — consumed at build/runtime:
# Public base URL of THIS app (frontend origin). Used to build absolute
# og:image / og:url meta tags for the share card (server-side OG images).
# In local dev both can be left unset (falls back to a relative /og/... path).
APP_URL=http://localhost:3000
# Public origin of the Express backend (server/src). Used by the SSR/client
# apiFetch helper in src/api/client.ts when the browser would hit a different host.
VITE_API_URL=http://localhost:4000

# Backend (Express) credentials — copy to server/.env:
DATABASE_URL=postgresql://...
OMDB_API_KEY=...
